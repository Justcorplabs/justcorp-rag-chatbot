# Copy to .env and configure credentials privately. Never commit real values.
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
MODEL_NAME=llama-3.1-8b-instant
CHROMA_DB_PATH=./chroma_db
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_WHATSAPP_ROUTES=false
ENABLE_TEST_ANSWER_ROUTE=false

# Future PostgreSQL persistence only; no connection or active authentication yet.
DATABASE_ENVIRONMENT=development
DATABASE_URL=
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=2
DATABASE_POOL_TIMEOUT=5

# Required only when using the WhatsApp integration.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_unique_whatsapp_verify_token_here
